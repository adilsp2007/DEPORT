# Email Configuration (Option 1: Gmail SMTP / Custom SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_google_app_password
DEFAULT_FROM_EMAIL="DEPORT Atelier <your_email@gmail.com>"
EMAIL_TIMEOUT=15

# Email Configuration (Option 2: AWS SES Direct API - Recommended for EC2 production)
# Set USE_AWS_SES=True to dispatch directly over HTTPS port 443 via boto3 (bypassing EC2 SMTP port blocks)
USE_AWS_SES=False
AWS_SES_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5

# Razorpay Standard Checkout Configuration (Get keys from https://dashboard.razorpay.com/#/access/api-keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CURRENCY=INR
